# Copy to .env.local for local development. Enter real values privately.
# The local Vite server persists its review data in .kitchen-dev/.
# SUPPERCLUB_DEV_ADMIN_EMAIL=
# SUPPERCLUB_DEV_ADMIN_PASSWORD=
#
# Configure these in the Vercel project's Production environment.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Or use the corresponding Vercel Marketplace pair.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# SUPPERCLUB_ADMIN_EMAIL=
# SUPPERCLUB_ADMIN_PASSWORD=
#
# Admin passwords require 15 or more characters.
# Keep all tokens and passwords server-side, with no VITE_ prefix.
